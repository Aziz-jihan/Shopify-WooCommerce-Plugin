{
  "info": {
    "_postman_id": "woocommerce-sync-bengali-names-en-tk",
    "name": "WooCommerce Data Sync Engine (English - Bengali Names - TK)",
    "description": "Complete Postman collection for WooCommerce: Connect store, fetch previous historical clothing data, and simulate real-time customer, order, and product webhooks (Create & Update). All customer names are Bengali, language is English, and currency is TK.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev-secret-key-1234",
      "type": "string"
    },
    {
      "key": "wooStoreId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Server Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Store Connection",
      "item": [
        {
          "name": "1. Connect WooCommerce Store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.store && json.store.id) {",
                  "    pm.collectionVariables.set('wooStoreId', json.store.id);",
                  "    console.log('Saved wooStoreId:', json.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"woocommerce\",\n  \"storeDomain\": \"https://oitijjo-clothing.local\",\n  \"apiKey\": \"ck_mock_demo_consumer_key_111\",\n  \"apiSecret\": \"cs_mock_demo_consumer_secret_222\",\n  \"isMock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stores/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "connect"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Connected Store Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Fetch Previous Data (Initial Sync)",
      "item": [
        {
          "name": "Fetch Previous Customers, Orders & Products",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "sync"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - WooCommerce Webhooks (Add & Update)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "1. Customer Created Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "customer.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 661122,\n  \"first_name\": \"Nazmul\",\n  \"last_name\": \"Haque\",\n  \"email\": \"nazmul.haque@example.com\",\n  \"billing\": {\n    \"phone\": \"+8801822334455\"\n  },\n  \"orders_count\": 1,\n  \"total_spent\": \"2800.00\",\n  \"currency\": \"TK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "2. Customer Updated Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "customer.updated"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 661122,\n  \"first_name\": \"Nazmul\",\n  \"last_name\": \"Haque (Platinum Member)\",\n  \"email\": \"nazmul.haque@example.com\",\n  \"billing\": {\n    \"phone\": \"+8801822334455\"\n  },\n  \"orders_count\": 4,\n  \"total_spent\": \"11200.00\",\n  \"currency\": \"TK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "3. Order Created Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "order.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 552233,\n  \"number\": \"WC-786\",\n  \"customer_id\": 661122,\n  \"total\": \"6500.00\",\n  \"currency\": \"TK\",\n  \"status\": \"completed\",\n  \"line_items\": [\n    {\n      \"name\": \"Katan Panjabi with Waistcoat Set\",\n      \"quantity\": 1,\n      \"price\": \"4500.00\"\n    },\n    {\n      \"name\": \"Pure Cotton Pajama\",\n      \"quantity\": 2,\n      \"price\": \"1000.00\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "4. Order Updated Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "order.updated"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 552233,\n  \"number\": \"WC-786\",\n  \"customer_id\": 661122,\n  \"total\": \"6500.00\",\n  \"currency\": \"TK\",\n  \"status\": \"completed\",\n  \"line_items\": [\n    {\n      \"name\": \"Katan Panjabi with Waistcoat Set\",\n      \"quantity\": 1,\n      \"price\": \"4500.00\"\n    },\n    {\n      \"name\": \"Pure Cotton Pajama\",\n      \"quantity\": 2,\n      \"price\": \"1000.00\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "5. Product Created Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "product.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 443322,\n  \"name\": \"Rajshahi Silk Handcrafted Saree\",\n  \"slug\": \"rajshahi-silk-handcrafted-saree\",\n  \"price\": \"8500.00\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "6. Product Updated Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "product.updated"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 443322,\n  \"name\": \"Rajshahi Silk Handcrafted Saree (Special Embroidery)\",\n  \"slug\": \"rajshahi-silk-saree-embroidery\",\n  \"price\": \"9200.00\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Query Stored Data",
      "item": [
        {
          "name": "1. Get Stored Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "customers"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Stored Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Stored Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "products"]
            }
          },
          "response": []
        },
        {
          "name": "4. Get Webhook Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "webhooks"]
            }
          },
          "response": []
