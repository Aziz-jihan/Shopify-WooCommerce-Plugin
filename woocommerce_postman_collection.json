            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "০৫ - ডাটাবেজের সংরক্ষিত ডাটা দেখুন (Query Stored Data)",
      "item": [
        {
          "name": "১. সংরক্ষিত সকল গ্রাহক দেখুন (Get Customers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "customers"]
            }
          },
          "response": []
        },
        {
          "name": "২. সংরক্ষিত অর্ডারসমূহ দেখুন (Get Orders)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "৩. সংরক্ষিত পোশাক পণ্য তালিকা (Get Products)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "products"]
            }
          },
          "response": []
        },
        {
          "name": "৪. ওয়েব হুক ইভেন্ট লগ দেখুন (Get Webhook Logs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/webhooks",
              "host": ["{{baseUrl}}"],
