              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "৫. নতুন পোশাক পণ্য যোগ (Product Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "product.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 443322,\n  \"name\": \"রাজশাহী সিল্ক শাড়ি\",\n  \"slug\": \"rajshahi-silk-saree\",\n  \"price\": \"8500.00\",\n  \"status\": \"সক্রিয়\"\n}"
