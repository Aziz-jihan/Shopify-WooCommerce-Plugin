{
  "info": {
    "_postman_id": "woocommerce-sync-bengali-tk-v1",
    "name": "WooCommerce Data Sync Engine (বাংলা ও টাকা TK)",
    "description": "WooCommerce-এর জন্য সম্পূর্ণ Postman কালেকশন: কানেক্ট করা, পূর্ববর্তী ডাটা ফেচ করা (পাঞ্জাবি, জামদানি শাড়ি ইত্যাদি), এবং রিয়েল-টাইম গ্রাহক, অর্ডার ও প্রোডাক্ট অ্যাড ও আপডেট ওয়েব হুক টেস্ট করা।",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev-secret-key-1234",
      "type": "string"
    },
    {
      "key": "wooStoreId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "০১ - সার্ভার হেলথ চেক (Health Check)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "সার্ভার স্ট্যাটাস চেক",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "০২ - উকমার্স স্টোর কানেকশন (Connect Store)",
      "item": [
        {
          "name": "১. উকমার্স স্টোর কানেক্ট করুন (Connect Store)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.store && json.store.id) {",
                  "    pm.collectionVariables.set('wooStoreId', json.store.id);",
                  "    console.log('WooCommerce Store ID সংরক্ষিত হয়েছে:', json.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"woocommerce\",\n  \"storeDomain\": \"https://oitijjo-clothing.local\",\n  \"apiKey\": \"ck_mock_demo_consumer_key_111\",\n  \"apiSecret\": \"cs_mock_demo_consumer_secret_222\",\n  \"isMock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stores/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "connect"]
            }
          },
          "response": []
        },
        {
          "name": "২. কানেক্টেড উকমার্স স্টোরের বিবরণ দেখুন",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "০৩ - পূর্ববর্তী ডাটা সিঙ্ক (Fetch Previous Data)",
      "item": [
        {
          "name": "পূর্ববর্তী সকল গ্রাহক, অর্ডার ও পোশাক পণ্য ফেচ করুন (Trigger Initial Sync)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{wooStoreId}}/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{wooStoreId}}", "sync"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "০৪ - উকমার্স ওয়েব হুক (Webhooks: Add & Update)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "১. নতুন গ্রাহক যোগ (Customer Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "customer.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 661122,\n  \"first_name\": \"নাজমুল\",\n  \"last_name\": \"হক\",\n  \"email\": \"nazmul.haque@example.com\",\n  \"billing\": {\n    \"phone\": \"+8801822334455\"\n  },\n  \"orders_count\": 1,\n  \"total_spent\": \"2800.00\",\n  \"currency\": \"TK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{wooStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{wooStoreId}}"]
            }
          },
          "response": []
        },
        {
          "name": "২. গ্রাহকের তথ্য আপডেট (Customer Updated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "customer.updated"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 661122,\n  \"first_name\": \"নাজমুল\",\n  \"last_name\": \"হক (প্লাটিনাম মেম্বার)\",\n  \"email\": \"nazmul.haque@example.com\",\n  \"billing\": {\n    \"phone\": \"+8801822334455\"\n  },\n  \"orders_count\": 4,\n  \"total_spent\": \"11200.00\",\n  \"currency\": \"TK\"\n}"
            },
            "url": {
