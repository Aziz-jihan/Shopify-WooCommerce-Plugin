            }
          },
          "response": []
        },
        {
          "name": "৬. পোশাক পণ্য আপডেট (Product Updated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "product.updated"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 443322,\n  \"name\": \"রাজশাহী সিল্ক শাড়ি (স্পেশাল এমব্রয়ডারি)\",\n  \"slug\": \"rajshahi-silk-saree-embroidery\",\n  \"price\": \"9200.00\",\n  \"status\": \"সক্রিয়\"\n}"
