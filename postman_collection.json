{
  "info": {
    "_postman_id": "7b58c8b4-32d1-4ad9-bf93-6c703b0c611f",
    "name": "Shopify & WooCommerce PostgreSQL Sync Engine",
    "description": "Collection to test the entire e-commerce sync workflow locally using Postman without needing a real Shopify or WooCommerce store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev-secret-key-1234",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Server Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Store Connection",
      "item": [
        {
          "name": "Connect Mock Shopify Store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.store && json.store.id) {",
                  "    pm.collectionVariables.set('storeId', json.store.id);",
                  "    console.log('Saved storeId:', json.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"shopify\",\n  \"storeDomain\": \"demo-apparel.myshopify.com\",\n  \"accessToken\": \"shpat_mock_token_for_testing\",\n  \"apiSecret\": \"shpss_mock_app_client_secret\",\n  \"isMock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stores/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "connect"]
            }
          },
          "response": []
        },
        {
          "name": "Connect Mock WooCommerce Store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.store && json.store.id) {",
                  "    pm.collectionVariables.set('storeId', json.store.id);",
                  "    console.log('Saved storeId:', json.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"woocommerce\",\n  \"storeDomain\": \"https://demo-electronics.local\",\n  \"apiKey\": \"ck_mock_consumer_key\",\n  \"apiSecret\": \"cs_mock_consumer_secret\",\n  \"isMock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stores/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "connect"]
            }
          },
          "response": []
        },
        {
          "name": "List Connected Stores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores"]
            }
          },
          "response": []
        },
        {
          "name": "Get Store by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Historical Sync",
      "item": [
        {
          "name": "Trigger Initial Sync",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "sync"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Realtime Webhook Simulation",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Simulate Shopify Customer Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Shopify-Topic",
                "value": "customers/create"
              },
              {
                "key": "X-Shopify-Shop-Domain",
                "value": "demo-apparel.myshopify.com"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 9928347101,\n  \"first_name\": \"Tony\",\n  \"last_name\": \"Stark\",\n  \"email\": \"tony@starkindustries.com\",\n  \"phone\": \"+1-555-0199\",\n  \"numberOfOrders\": 5,\n  \"amountSpent\": {\n    \"amount\": \"1450.00\",\n    \"currencyCode\": \"USD\"\n  },\n  \"defaultAddress\": {\n    \"address1\": \"10880 Malibu Point\",\n    \"city\": \"Malibu\",\n    \"province\": \"CA\",\n    \"country\": \"US\",\n    \"zip\": \"90265\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/shopify/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "shopify", "{{storeId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Simulate Shopify Order Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Shopify-Topic",
                "value": "orders/create"
              },
              {
                "key": "X-Shopify-Shop-Domain",
                "value": "demo-apparel.myshopify.com"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 883920192,\n  \"order_number\": \"#1099\",\n  \"customer_id\": 9928347101,\n  \"total_price\": \"499.00\",\n  \"currency\": \"USD\",\n  \"financial_status\": \"paid\",\n  \"fulfillment_status\": \"fulfilled\",\n  \"lineItems\": [\n    {\n      \"title\": \"Arc Reactor Mark IV\",\n      \"quantity\": 1,\n      \"price\": \"499.00\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/shopify/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "shopify", "{{storeId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Simulate WooCommerce Customer Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "customer.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 77281,\n  \"first_name\": \"Diana\",\n  \"last_name\": \"Prince\",\n  \"email\": \"diana@themyscira.gov\",\n  \"billing\": {\n    \"phone\": \"+1-555-0177\"\n  },\n  \"orders_count\": 2,\n  \"total_spent\": \"340.00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{storeId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Simulate WooCommerce Order Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-WC-Webhook-Topic",
                "value": "order.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 66291,\n  \"number\": \"66291\",\n  \"customer_id\": 77281,\n  \"total\": \"170.00\",\n  \"currency\": \"USD\",\n  \"status\": \"completed\",\n  \"lineItems\": [\n    {\n      \"name\": \"Lasso of Truth Replicate\",\n      \"quantity\": 1,\n      \"price\": 170.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/woocommerce/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "woocommerce", "{{storeId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Query Stored Data",
      "item": [
        {
          "name": "Get Synced Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "customers"]
            }
          },
          "response": []
        },
        {
          "name": "Get Synced Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "Get Synced Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "products"]
            }
          },
          "response": []
        },
        {
          "name": "Get Webhook Event Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{storeId}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{storeId}}", "webhooks"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
