    {
      "name": "04 - Realtime Webhooks to AutoMate (Zero DB Pass-Through)",
      "item": [
        {
          "name": "1. WooCommerce Order Webhook -> AutoMate (Abdur Rahman)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-automate-base-url", "value": "{{automateBaseUrl}}" },
              { "key": "x-automate-token", "value": "{{automateToken}}" },
              { "key": "x-platform", "value": "woocommerce" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 10501,\n  \"number\": \"WC-10501\",\n  \"status\": \"processing\",\n  \"total\": \"4200.00\",\n  \"customer_note\": \"Please deliver by Thursday afternoon.\",\n  \"billing\": {\n    \"first_name\": \"Abdur\",\n    \"last_name\": \"Rahman\",\n    \"phone\": \"01711223344\",\n    \"address_1\": \"House 12, Road 5, Dhanmondi\",\n    \"city\": \"Dhaka\",\n    \"country\": \"BD\"\n  },\n  \"shipping\": {\n    \"first_name\": \"Abdur\",\n    \"last_name\": \"Rahman\",\n    \"address_1\": \"House 12, Road 5, Dhanmondi\",\n    \"city\": \"Dhaka\",\n    \"country\": \"BD\"\n  },\n  \"line_items\": [\n    {\n      \"id\": 101,\n      \"product_id\": 5001,\n      \"name\": \"Premium Cotton Panjabi - Charcoal Black\",\n      \"quantity\": 1,\n      \"price\": \"2800.00\",\n      \"sku\": \"PANJABI-BLK-01\"\n    },\n    {\n      \"id\": 102,\n      \"product_id\": 5002,\n      \"name\": \"Silk Pajama - Pearl White\",\n      \"quantity\": 1,\n      \"price\": \"1400.00\",\n      \"sku\": \"PAJAMA-WHT-01\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bridge/webhook/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bridge", "webhook", "order"]
            }
          },
          "response": []
        },
        {
          "name": "2. Shopify Order Webhook -> AutoMate (Nusrat Jahan)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-automate-base-url", "value": "{{automateBaseUrl}}" },
              { "key": "x-automate-token", "value": "{{automateToken}}" },
              { "key": "x-shopify-topic", "value": "orders/create" },
