{
  "info": {
    "_postman_id": "automate-stateless-bridge-bengali-names-en-tk",
    "name": "AutoMate Stateless E-Commerce Bridge (Zero DB)",
    "description": "Stateless in-memory bridge connecting Shopify and WooCommerce stores directly to AutoMate (Automate Plugin spec). Strips all DB requirements. Features Bengali customer names in English script, TK currency, and Bangladeshi clothing catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "automateBaseUrl",
      "value": "mock",
      "type": "string"
    },
    {
      "key": "automateToken",
      "value": "mock_token_43_characters_demo_key_example",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health & AutoMate Handshake",
      "item": [
        {
          "name": "1. Server Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "2. Test AutoMate Connection (Handshake)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-automate-base-url", "value": "{{automateBaseUrl}}" },
              { "key": "x-automate-token", "value": "{{automateToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"automateBaseUrl\": \"{{automateBaseUrl}}\",\n  \"automateToken\": \"{{automateToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bridge/automate/test-connection",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bridge", "automate", "test-connection"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Store Connection Tests (Stateless)",
      "item": [
