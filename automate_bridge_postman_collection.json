              "raw": "{\n  \"id\": 88223344,\n  \"name\": \"#SHP-501\",\n  \"total_price\": \"12500.00\",\n  \"currency\": \"TK\",\n  \"financial_status\": \"paid\",\n  \"note\": \"Handle with care, gift box packaging required.\",\n  \"customer\": {\n    \"first_name\": \"Nusrat\",\n    \"last_name\": \"Jahan\",\n    \"phone\": \"+8801819876543\"\n  },\n  \"shipping_address\": {\n    \"address1\": \"Holding 45, GEC Circle\",\n    \"city\": \"Chittagong\",\n    \"country\": \"Bangladesh\",\n    \"phone\": \"01819876543\"\n  },\n  \"line_items\": [\n    {\n      \"id\": 301,\n      \"product_id\": 7701,\n      \"title\": \"Dhakai Jamdani Saree (Red & Gold Zari Work)\",\n      \"quantity\": 1,\n      \"price\": \"12500.00\",\n      \"sku\": \"JAMDANI-RED-01\"\n    }\n  ]\n}"
            },
