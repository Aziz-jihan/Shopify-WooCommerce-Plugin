{
  "info": {
    "_postman_id": "shopify-sync-bengali-names-en-tk",
    "name": "Shopify Data Sync Engine (English - Bengali Names - TK)",
    "description": "Complete Postman collection for Shopify: Connect store, fetch previous historical clothing data, and simulate real-time customer, order, and product webhooks (Create & Update). All customer names are Bengali, language is English, and currency is TK.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev-secret-key-1234",
      "type": "string"
    },
    {
      "key": "shopifyStoreId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Server Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Store Connection",
      "item": [
        {
          "name": "1. Connect Shopify Store",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.store && json.store.id) {",
                  "    pm.collectionVariables.set('shopifyStoreId', json.store.id);",
                  "    console.log('Saved shopifyStoreId:', json.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"shopify\",\n  \"storeDomain\": \"banglar-fashion.myshopify.com\",\n  \"accessToken\": \"shpat_mock_demo_token_12345\",\n  \"apiSecret\": \"shpss_mock_app_client_secret_67890\",\n  \"isMock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stores/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "connect"]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Connected Store Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{shopifyStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{shopifyStoreId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Fetch Previous Data (Initial Sync)",
      "item": [
        {
          "name": "Fetch Previous Customers, Orders & Products",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stores/{{shopifyStoreId}}/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stores", "{{shopifyStoreId}}", "sync"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Shopify Webhooks (Add & Update)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "1. Customer Created Webhook",
