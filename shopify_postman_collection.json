            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Shopify-Topic",
                "value": "customers/create"
              },
              {
                "key": "X-Shopify-Shop-Domain",
                "value": "banglar-fashion.myshopify.com"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 99112233,\n  \"first_name\": \"Mahmudul\",\n  \"last_name\": \"Hasan\",\n  \"email\": \"mahmudul.hasan@example.com\",\n  \"phone\": \"+8801755443322\",\n  \"numberOfOrders\": 1,\n  \"amountSpent\": {\n    \"amount\": \"3500.00\",\n    \"currencyCode\": \"TK\"\n  },\n  \"defaultAddress\": {\n    \"address1\": \"House 18, Road 2, Mirpur-10\",\n    \"city\": \"Dhaka\",\n    \"province\": \"Dhaka Division\",\n    \"country\": \"Bangladesh\",\n    \"zip\": \"1216\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/shopify/{{shopifyStoreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "shopify", "{{shopifyStoreId}}"]
            }
          },
          "response": []
